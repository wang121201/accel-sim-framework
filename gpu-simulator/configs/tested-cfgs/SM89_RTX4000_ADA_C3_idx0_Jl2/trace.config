# EXPERIMENTAL RTX4000 Ada migration from official SM86_RTX3070; not validated/tuned.
# SM/register/occupancy/L2/memory-clock values come from cudaGetDeviceProperties JSON.
# Core frequency must match the fixed hardware profiling clock; CUDA max clock alone is not evidence of actual clock.
# Interconnect and L2 clocks are approximated by the SM clock as in the RTX3070 baseline.
# 16-bit controllers and two L2 subpartitions/controller are model assumptions, not measured topology.
# L2 capacity is exact; 16-way organization and XOR set hashing are unvalidated approximations.
# L2 uses X (XOR), since inherited P/IPOLY only supports 16/32/64 sets, not 1024.
# Partition hashing stays 2: IPOLY over next-power-of-two then modulo 20; physical Ada mapping is unknown.
# Do not use indexing=6 here: its IPOLY group count is 4, unsupported by the current hashing.cc.
# All FU latencies/initiation, tensor timing, DRAM timings, cache latencies, queues and launch latency are inherited and uncalibrated.
# Power modeling is disabled: no RTX4000 Ada AccelWattch power model is claimed.
# No TMA/WGMMA/Hopper behavior is enabled. Unknown trace opcodes remain fatal.
# Ada limits: https://docs.nvidia.com/cuda/ada-tuning-guide/index.html
# Official RTX4000 specifications: https://www.nvidia.com/content/dam/en-zz/Solutions/products/workstations/nvidia-rtx-4000-datasheet.pdf
# Shared Ampere/Ada opcode documentation: https://docs.nvidia.com/cuda/archive/12.8.0/cuda-binary-utilities/index.html#nvidia-ampere-gpu-and-ada-instruction-set

-trace_opcode_latency_initiation_int 2,2
-trace_opcode_latency_initiation_sp 2,1
-trace_opcode_latency_initiation_dp 64,64
-trace_opcode_latency_initiation_sfu 21,8
-trace_opcode_latency_initiation_tensor 32,32

#execute branch insts on spec unit 1
#<enabled>,<num_units>,<max_latency>,<ID_OC_SPEC>,<OC_EX_SPEC>,<NAME>
-specialized_unit_1 1,4,4,4,4,BRA
-trace_opcode_latency_initiation_spec_op_1 4,4

#TEX unit, make fixed latency for all tex insts
-specialized_unit_2 1,4,200,4,4,TEX
-trace_opcode_latency_initiation_spec_op_2 200,4

#tensor unit
-specialized_unit_3 1,4,32,4,4,TENSOR
-trace_opcode_latency_initiation_spec_op_3 32,32

#UDP unit, for turing and above
#for more info about UDP, see https://www.hotchips.org/hc31/HC31_2.12_NVIDIA_final.pdf
-specialized_unit_4 1,4,4,4,4,UDP
-trace_opcode_latency_initiation_spec_op_4 4,1
